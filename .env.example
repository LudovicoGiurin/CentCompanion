# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender on centcomp.net
EMAIL_FROM=noreply@centcomp.net

# Public app URL (production: https://centcomp.net)
APP_URL=https://centcomp.net

# JWT signing secret (use a long random string in production)
JWT_SECRET=cent-companion-dev-secret-change-in-prod

# Neon Postgres connection string (local dev — use direct URL, not Hyperdrive)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Cloudflare Turnstile — site key is public (also set in Cloudflare Pages build env)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADvjJWSNT1bZxwk2
